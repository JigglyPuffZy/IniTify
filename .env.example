# Hospital data — static-tuguegarao (Tuguegarao City curated list for thesis demo)
EXPO_PUBLIC_HOSPITAL_DATA_PROVIDER=static-tuguegarao

# Maps/navigation — google | apple | waze
EXPO_PUBLIC_MAPS_PROVIDER=google

# Manual heat index for assessment demo (NOT live API weather)
EXPO_PUBLIC_DEV_MANUAL_HEAT=true

# Database: firebase | mysql | supabase
EXPO_PUBLIC_DATABASE_PROVIDER=supabase
EXPO_PUBLIC_MYSQL_API_URL=http://192.168.1.100:3001

# Supabase — Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key

# Optional backend news feed URL (else app reads Supabase directly)
# EXPO_PUBLIC_NEWS_API_URL=http://192.168.1.100:3001/api/pagasa-news

# Server (.env at project root or server/) — DOST-PAGASA news collector
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-key
ADMIN_API_KEY=change-me
OPENAI_API_KEY=
PAGASA_NEWS_CRON=*/30 * * * *
PAGASA_NEWS_REQUIRE_ADMIN_APPROVE=false

# Decision Tree — rules are in src/config/decision-tree.rules.ts (set enabled: true)
