# Hospital data — static-tuguegarao (Tuguegarao City curated list for thesis demo)
EXPO_PUBLIC_HOSPITAL_DATA_PROVIDER=static-tuguegarao

# Maps/navigation — google | apple | waze
EXPO_PUBLIC_MAPS_PROVIDER=google

# Live weather — Open-Meteo (no API key required)
# https://api.open-meteo.com/v1/forecast?latitude=17.6132&longitude=121.727&current=...
# EXPO_PUBLIC_WEATHERAPI_KEY is unused (legacy)

# Manual heat fallback only if Open-Meteo fetch fails
EXPO_PUBLIC_DEV_MANUAL_HEAT=false

# Supabase — Dashboard → Project Settings → API
EXPO_PUBLIC_DATABASE_PROVIDER=supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon JWT
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Decision Tree — rules are in src/config/decision-tree.rules.ts (set enabled: true)

# Conversational check-in AI (OpenAI-compatible) — optional
# EXPO_PUBLIC_CHECK_IN_AI_API_KEY=sk-your-key
# EXPO_PUBLIC_CHECK_IN_AI_BASE_URL=https://api.openai.com/v1
# EXPO_PUBLIC_CHECK_IN_AI_MODEL=gpt-4o-mini
