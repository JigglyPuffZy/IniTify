# DOST-PAGASA heat-index API (NOT CONFIGURED)
# Provider: "tenday" (official TenDay API) or "custom" (your heat-index endpoint)
EXPO_PUBLIC_PAGASA_PROVIDER=tenday

# TenDay API token — request at https://tenday.pagasa.dost.gov.ph (formal approval required)
EXPO_PUBLIC_PAGASA_API_KEY=

# Optional location overrides for TenDay queries (study location: Tuguegarao City, Cagayan)
EXPO_PUBLIC_PAGASA_PROVINCE=Cagayan
EXPO_PUBLIC_PAGASA_MUNICITY=Tuguegarao City
EXPO_PUBLIC_PAGASA_REGION=

# Development only — manual heat index for testing WITHOUT PAGASA (not live data)
EXPO_PUBLIC_DEV_MANUAL_HEAT=true

# Custom provider only — direct heat-index endpoint
EXPO_PUBLIC_PAGASA_API_URL=
EXPO_PUBLIC_PAGASA_HEAT_INDEX_FIELD=heatIndex

# Hospital data provider (NOT CONFIGURED)
EXPO_PUBLIC_HOSPITAL_DATA_PROVIDER=

# Mapping/navigation provider (NOT CONFIGURED)
EXPO_PUBLIC_MAPS_PROVIDER=

# Database: firebase | mysql (NOT CONFIGURED)
EXPO_PUBLIC_DATABASE_PROVIDER=

# Decision Tree — rules are in src/config/decision-tree.rules.ts (set enabled: true)
