# MySQL (optional — when EXPO_PUBLIC_DATABASE_PROVIDER=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=initify_db
PORT=3001

# Supabase (required for PAGASA news collector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Automatic collection — no manual news entry
PAGASA_NEWS_CRON=*/30 * * * *
PAGASA_NEWS_RUN_ON_START=true
PAGASA_NEWS_SCHEDULER_ENABLED=true
# false = auto-publish to app after official source validation (default)
PAGASA_NEWS_REQUIRE_ADMIN_APPROVE=false

# AI summarization (optional — extract-only fallback when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin review API (required for /admin/pagasa-news routes)
ADMIN_API_KEY=change-me-in-production
